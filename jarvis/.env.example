# ─── Plaid (banks, credit cards, Robinhood, Fidelity, etc.) ───────────────
# Get keys at https://dashboard.plaid.com/developers/keys
# PLAID_ENV: sandbox (fake test banks) | production (your real accounts)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# ─── Finnhub (live stock quotes + market/company news) ────────────────────
# Free key at https://finnhub.io/register
FINNHUB_API_KEY=

# ─── Anthropic (Jarvis briefings, "why am I down", recommendations, chat) ─
# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: protect the dashboard with a password (recommended if you ever
# run it anywhere other than localhost). Username can be anything.
DASHBOARD_PASSWORD=
